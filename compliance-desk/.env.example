# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance_desk
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
LLM_MAX_TOKENS=8192
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
# AWS uses the task role; never put access keys in this file on ECS.
AWS_REGION=ap-south-1
S3_BUCKET=
EMAIL_FROM=
# Enable only behind an ingress that appends/overwrites forwarding headers.
TRUST_PROXY=false
# Local production smoke testing only. AWS should use S3 and HTTPS.
ALLOW_LOCAL_STORAGE=false
ALLOW_HTTP=false
# Optional: preinstalled Tesseract English data directory, bundled in Docker.
TESSERACT_LANG_PATH=
